---
import "../styles/global.css";
import Navbar from "../Components/navbar.astro";
import Footer from "../Components/footer.astro";

const heroSlides = [
	"https://www.baltana.com/files/wallpapers-5/Raspberry-HD-Desktop-Wallpaper-16909.jpg",
	"https://images.unsplash.com/photo-1464226184884-fa280b87c399",
	"https://images.unsplash.com/photo-1502741338009-cac2772e18bc",
];

const certs = [
	{ name: "Kosher", tag: "Certificación" },
	{ name: "PrimusGFS", tag: "Certificación" },
	{ name: "HACCP", tag: "Inocuidad" },
	{ name: "BPM", tag: "Manufactura" },
];

const fruits = [
	{
		name: "Mango",
		href: "/productos/mango",
		tag: "IQF · Puré",
		img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQuu2lK_pa7Mf2W5mAkl2V_VDTmnZ43brmDuQ&s",
		des: "Cultivado con técnicas sostenibles, nuestro mango ofrece un sabor dulce y jugoso, ideal para consumo fresco o en preparaciones culinarias.",
	},
	{
		name: "Fresa",
		href: "/productos/fresa",
		tag: "IQF · Puré",
		img: "https://www.agrorganicos.mx/cdn/shop/products/fresa_1080x.jpg?v=1569251998",
		des: "Nuestras fresas son cultivadas con procesos naturales, garantizando un sabor dulce y una textura jugosa, perfectas para consumo fresco o en postres.",
	},
	{
		name: "Frambuesa",
		href: "/productos/frambuesa",
		tag: "IQF",
		img: "https://maiaorganicos.mx/wp-content/uploads/2021/04/frambuesas-natural.jpg",
		des: "Cultivada con técnicas sostenibles, nuestra frambuesa ofrece un sabor intenso y una textura jugosa, ideal para consumo fresco o en preparaciones culinarias.",
	},
	{
		name: "Kiwi y Maracuyá",
		href: "/productos/km",
		tag: "IQF · Pulpa",
		img: "/purekiwi.jpeg",
		des: "Kiwi de textura firme y pulpa de maracuyá 100% pura, con aroma intenso para repostería, bebidas y concentrados.",
	},
];

const stats = [
	{ value: "9+", label: "Años de experiencia" },
	{ value: "5+", label: "Productos" },
	{ value: "3+", label: "Mercados" },
];

const philosophy = [
	{
		title: "Misión",
		text: "Ofrecer a nuestros clientes frutas y verduras congeladas asegurando altos estándares de calidad e inocuidad, manteniendo nuestros valores.",
		icon: "M12 2a10 10 0 1 0 10 10M12 6a6 6 0 1 0 6 6m-6-2a2 2 0 1 0 2 2m0-2 7-7m0 0h-3m3 0v3",
	},
	{
		title: "Visión",
		text: "Ser una empresa reconocida internacionalmente por la calidad y manejo de nuestros productos agroalimentarios.",
		icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.5-2.4 3.75-5.4 3.75-9S14.5 5.4 12 3m0 18c-2.5-2.4-3.75-5.4-3.75-9S9.5 5.4 12 3M3.5 9h17m-17 6h17",
	},
	{
		title: "Valores",
		values: ["Competitividad", "Responsabilidad", "Iniciativa", "Confianza", "Pasión"],
		icon: "M7 11 4.5 8.5a2.1 2.1 0 0 1 3-3L12 10l4.5-4.5a2.1 2.1 0 0 1 3 3L12 16l-5-5Zm-3 9h16",
	},
];

const steps = [
	{
		title: "Cultivo",
		text: "Semillas seleccionadas y técnicas sostenibles.",
		icon: "M12 21v-9m0 0c0-4 3-7 7-7 0 4-3 7-7 7Zm0 0C12 8 9 5 5 5c0 4 3 7 7 7Z",
	},
	{
		title: "Cosecha",
		text: "Recolectamos cada fruta en su punto perfecto.",
		icon: "M5 21c0-9 5-15 14-16-1 9-7 14-16 14m4-4 6-6",
	},
	{
		title: "Empaque",
		text: "Clasificación y empaque para mantener frescura.",
		icon: "m21 7.5-9-4.5-9 4.5m18 0-9 4.5m9-4.5v9L12 21m0-9L3 7.5m9 4.5v9M3 7.5v9L12 21",
	},
	{
		title: "Distribución",
		text: "Llevamos fruta de calidad a mercados internacionales.",
		icon: "M3 7h11v9H3zm11 3h4l3 3v3h-7M7.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z",
	},
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Sano y Nutritivo Zamora | Frutas y Productos del Campo</title>
		<meta
			name="description"
			content="Sano y Nutritivo Zamora: producción y exportación de frutas congeladas IQF y purés con certificación Kosher y PrimusGFS."
		/>
		<link rel="icon" href="/snz2.ico" />
		<meta name="google-site-verification" content="WFmqMszxb4OnPNz0WyLyd5nfs2ZN68Q9yiOe0BMQ6SY" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body class="font-body bg-[#f6f8f4] text-slate-700 antialiased">
		<!-- NAVBAR -->
		<Navbar />

		<!-- HERO -->
		<section class="relative min-h-[100svh] flex items-end overflow-hidden text-white">
			<div class="absolute inset-0">
				{
					heroSlides.map((src, i) => (
						<img
							src={src}
							alt=""
							fetchpriority={i === 0 ? "high" : "low"}
							class:list={["hero-img hero-slide absolute inset-0 w-full h-full object-cover", { active: i === 0 }]}
						/>
					))
				}
			</div>

			<!-- capas de color -->
			<div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/25 to-black/70"></div>
			<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_80%,rgba(22,101,52,0.55),transparent_60%)]"></div>

			<div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-40 pb-16 md:pb-24">
				<div class="grid lg:grid-cols-12 gap-10 items-end">
					<div class="lg:col-span-8 reveal">
						<span class="glass-pill inline-flex items-center gap-2 px-4 py-2 mb-8 text-[11px] font-semibold tracking-[0.3em] uppercase">
							<span class="w-1.5 h-1.5 rounded-full bg-lime-300 shadow-[0_0_12px_#bef264]"></span>
							Excelencia en el campo · Zamora, Mich.
						</span>

						<h1 class="font-display text-5xl sm:text-6xl md:text-7xl xl:text-8xl leading-[0.95] tracking-tight mb-8">
							Sano y Nutritivo
							<span class="block italic text-transparent bg-clip-text bg-gradient-to-r from-lime-200 via-green-300 to-emerald-400">
								Zamora
							</span>
						</h1>

						<p class="text-lg md:text-xl text-white/85 max-w-xl leading-relaxed mb-10">
							Calidad del campo directamente a tu negocio, con procesos
							sostenibles y estándares de exportación.
						</p>

						<div class="flex flex-wrap gap-4">
							<a
								href="#productos"
								class="btn-primary inline-flex items-center gap-3 px-7 py-4 rounded-full font-semibold"
							>
								Ver productos
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
							</a>
							<a
								href="/contactanos"
								class="glass-pill inline-flex items-center gap-3 px-7 py-4 rounded-full font-semibold hover:bg-white/20 transition"
							>
								Solicitar cotización
							</a>
						</div>
					</div>

					<!-- tarjeta de stats -->
					<div class="lg:col-span-4 reveal" style="--d: 150ms">
						<div class="glass-dark rounded-[2rem] p-7">
							<p class="text-[11px] font-semibold tracking-[0.25em] uppercase text-white/60 mb-5">
								En cifras
							</p>
							<div class="grid grid-cols-3 gap-4">
								{
									stats.map((s) => (
										<div>
											<p class="font-display text-4xl text-white">{s.value}</p>
											<p class="text-xs text-white/65 mt-1 leading-snug">{s.label}</p>
										</div>
									))
								}
							</div>
							<div class="mt-6 pt-5 border-t border-white/15 flex items-center justify-between">
								<div class="flex gap-2" aria-label="Diapositivas">
									{
										heroSlides.map((_, i) => (
											<button
												type="button"
												aria-label={`Imagen ${i + 1}`}
												data-slide={i}
												class:list={["hero-dot h-1.5 rounded-full bg-white/30 transition-all duration-500", { active: i === 0 }]}
											/>
										))
									}
								</div>
								<span class="text-xs text-white/60">Desliza ↓</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CERTIFICACIONES -->
		<section class="relative z-20 -mt-10 px-6">
			<div class="max-w-6xl mx-auto glass rounded-[2rem] px-6 py-6 md:px-10 reveal">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:divide-x divide-slate-900/10">
					{
						certs.map((c) => (
							<div class="flex items-center gap-3 md:gap-4 md:justify-center md:px-4">
								<div class="shrink-0 w-11 h-11 flex items-center justify-center rounded-2xl bg-gradient-to-br from-green-500 to-emerald-700 text-white shadow-[0_8px_20px_-6px_rgba(21,128,61,0.7),inset_0_1px_0_rgba(255,255,255,0.4)]">
									<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.5 3.2 8.3 7.5 9.5 4.3-1.2 7.5-5 7.5-9.5V6L12 3Z" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
								</div>
								<div>
									<p class="text-[9px] md:text-[10px] font-semibold tracking-[0.08em] md:tracking-[0.2em] uppercase text-slate-500">{c.tag}</p>
									<p class="font-bold text-slate-900" data-key={c.name}>{c.name}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- FRUTAS / PRODUCTOS -->
		<section id="productos" class="relative scroll-mt-20 py-28 md:py-36 px-6 overflow-hidden">
			<div class="blob w-[520px] h-[520px] bg-lime-200/60 -top-20 -left-40"></div>
			<div class="blob w-[420px] h-[420px] bg-emerald-200/50 bottom-0 -right-32"></div>

			<div class="relative max-w-7xl mx-auto">
				<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14 reveal">
					<div>
						<p class="eyebrow mb-4">Nuestros productos</p>
						<h2 class="font-display text-4xl md:text-6xl text-slate-900 leading-tight">
							Fruta seleccionada,<br class="hidden md:block" />
							<span class="italic text-green-700">lista para tu industria</span>
						</h2>
					</div>
					<p class="text-slate-500 max-w-xs md:text-right">
						Elige una fruta para conocer sus presentaciones y
						especificaciones.
					</p>
				</div>

				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{
						fruits.map((fruit, i) => (
							<a
								href={fruit.href}
								class="fruit-card reveal group relative block h-[26rem] rounded-[2rem] overflow-hidden"
								style={`--d: ${i * 90}ms`}
							>
								<img
									src={fruit.img}
									alt={fruit.name}
									loading="lazy"
									class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />

								<span class="glass-pill absolute top-4 left-4 px-3 py-1.5 bg-black/35 text-[11px] font-semibold tracking-wider text-white">
									{fruit.tag}
								</span>

								<div class="glass-dark absolute inset-x-3 bottom-3 rounded-[1.5rem] p-5 text-white transition-all duration-500">
									<div class="flex items-center justify-between gap-3">
										<h3 class="font-display text-2xl">{fruit.name}</h3>
										<span class="w-9 h-9 shrink-0 flex items-center justify-center rounded-full bg-white/15 border border-white/25 transition-all duration-500 group-hover:bg-white group-hover:text-green-800 group-hover:-rotate-45">
											<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
										</span>
									</div>
									<p class="fruit-desc text-sm text-white/80 leading-relaxed">
										{fruit.des}
									</p>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<!-- SOBRE NOSOTROS -->
		<section class="relative py-24 md:py-32 px-6">
			<div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
				<!-- IMAGEN -->
				<div class="relative reveal">
					<div class="absolute -inset-6 rounded-[3rem] bg-gradient-to-br from-lime-200/70 to-emerald-300/40 blur-2xl"></div>
					<img
						src="sano.jpg"
						class="relative w-full aspect-[4/5] md:aspect-[5/4] rounded-[2rem] object-cover shadow-[0_30px_80px_-20px_rgba(20,83,45,0.45)]"
						alt="Instalaciones de Sano y Nutritivo Zamora"
						loading="lazy"
					/>
					<div class="glass absolute -bottom-8 right-4 md:-right-8 rounded-[1.5rem] px-6 py-5 flex items-center gap-4">
						<p class="font-display text-5xl text-green-700">9+</p>
						<p class="text-sm font-medium text-slate-700 leading-tight">
							años cultivando<br />confianza
						</p>
					</div>
				</div>

				<!-- TEXTO -->
				<div class="reveal" style="--d: 120ms">
					<p class="eyebrow mb-4">Sobre nosotros</p>
					<h2 class="font-display text-4xl md:text-5xl text-slate-900 mb-6 leading-tight">
						Una empresa familiar con <span class="italic text-green-700">raíces en el campo</span>
					</h2>
					<p class="text-lg text-slate-600 leading-relaxed mb-10">
						Somos una empresa familiar dedicada a la producción y
						exportación de frutas. Nuestro compromiso es ofrecer
						alimentos saludables cultivados con procesos responsables y
						respeto al medio ambiente.
					</p>

					<div class="grid grid-cols-3 gap-4 mb-10">
						{
							stats.map((s) => (
								<div class="glass rounded-2xl px-4 py-5 text-center">
									<p class="font-display text-3xl text-green-700">{s.value}</p>
									<p class="text-xs text-slate-500 mt-1">{s.label}</p>
								</div>
							))
						}
					</div>

					<a href="/nosotros" class="link-arrow">
						Conoce nuestra historia
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</section>

		<!-- MISION / VISION / VALORES -->
		<section class="relative py-28 md:py-36 px-6 overflow-hidden bg-gradient-to-b from-transparent via-green-50 to-transparent">
			<div class="blob w-[600px] h-[600px] bg-green-200/50 top-10 left-1/2 -translate-x-1/2"></div>

			<div class="relative max-w-7xl mx-auto">
				<div class="text-center max-w-2xl mx-auto mb-16 reveal">
					<p class="eyebrow mb-4 justify-center">Nuestra filosofía</p>
					<h2 class="font-display text-4xl md:text-5xl text-slate-900 leading-tight">
						Lo que nos mueve <span class="italic text-green-700">cada temporada</span>
					</h2>
				</div>

				<div class="grid gap-6 md:grid-cols-3">
					{
						philosophy.map((p, i) => (
							<div class="glass glass-hover reveal rounded-[2rem] p-9" style={`--d: ${i * 110}ms`}>
								<div class="w-14 h-14 mb-8 flex items-center justify-center rounded-2xl bg-gradient-to-br from-green-500 to-emerald-700 text-white shadow-[0_10px_24px_-8px_rgba(21,128,61,0.7),inset_0_1px_0_rgba(255,255,255,0.4)]">
									<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon} /></svg>
								</div>
								<h3 class="font-display text-2xl text-slate-900 mb-4">{p.title}</h3>
								{p.text && <p class="text-slate-600 leading-relaxed">{p.text}</p>}
								{p.values && (
									<ul class="flex flex-wrap gap-2">
										{p.values.map((v) => (
											<li class="px-3 py-1.5 text-sm rounded-full bg-white/70 border border-white text-green-800 font-medium shadow-sm">
												{v}
											</li>
										))}
									</ul>
								)}
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- PROCESO -->
		<section class="py-28 md:py-36 px-6">
			<div class="max-w-6xl mx-auto">
				<div class="text-center max-w-2xl mx-auto mb-20 reveal">
					<p class="eyebrow mb-4 justify-center">Nuestro proceso</p>
					<h2 class="font-display text-4xl md:text-5xl text-slate-900 leading-tight">
						Del campo a tu mercado, <span class="italic text-green-700">sin perder frescura</span>
					</h2>
				</div>

				<div class="relative">
					<div class="hidden md:block absolute top-8 left-[12.5%] right-[12.5%] h-px bg-gradient-to-r from-transparent via-green-400 to-transparent"></div>
					<div class="grid sm:grid-cols-2 md:grid-cols-4 gap-12 md:gap-8">
						{
							steps.map((s, i) => (
								<div class="relative text-center reveal" style={`--d: ${i * 120}ms`}>
									<div class="glass relative w-16 h-16 mx-auto mb-7 flex items-center justify-center rounded-2xl text-green-700">
										<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
										<span class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-green-700 text-white text-[11px] font-bold flex items-center justify-center shadow-md">
											{i + 1}
										</span>
									</div>
									<h3 class="font-bold text-lg text-slate-900 mb-2">{s.title}</h3>
									<p class="text-sm text-slate-500 leading-relaxed max-w-[15rem] mx-auto">{s.text}</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- CTA FINAL -->
		<section class="px-6 pb-28">
			<div class="relative max-w-6xl mx-auto rounded-[2.5rem] overflow-hidden reveal">
				<img
					src="https://images.unsplash.com/photo-1464226184884-fa280b87c399"
					alt=""
					loading="lazy"
					class="absolute inset-0 w-full h-full object-cover"
				/>
				<div class="absolute inset-0 bg-gradient-to-br from-green-950/90 via-green-900/75 to-emerald-800/60"></div>

				<div class="relative grid md:grid-cols-5 gap-10 items-center px-8 py-16 md:px-16 md:py-20 text-white">
					<div class="md:col-span-3">
						<p class="eyebrow eyebrow-light mb-4">Trabajemos juntos</p>
						<h2 class="font-display text-4xl md:text-5xl leading-tight mb-5">
							¿Buscas un proveedor confiable de fruta?
						</h2>
						<p class="text-lg text-white/75 leading-relaxed">
							Si buscas frutas de calidad para tu negocio o distribución,
							podemos ayudarte a llevar productos certificados a tu mercado.
						</p>
					</div>
					<div class="md:col-span-2">
						<div class="glass-dark rounded-[2rem] p-7 flex flex-col gap-4">
							<a
								href="/contactanos"
								class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full font-semibold bg-white text-green-900 hover:bg-lime-100 transition shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5)]"
							>
								Contactar a ventas
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
							</a>
							<a
								href="#productos"
								class="glass-pill inline-flex items-center justify-center px-7 py-4 rounded-full font-semibold hover:bg-white/20 transition"
							>
								Explorar productos
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- FOOTER -->
		<Footer />
	</body>
</html>

<style>
	/* en la capa components para que las utilidades de Tailwind (absolute, etc.) tengan prioridad */
	@layer components {
	:global(html) {
		scroll-behavior: smooth;
	}

	/* ---------- tipografía ---------- */
	.font-body {
		font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
	}
	.font-display {
		font-family: "Fraunces", ui-serif, Georgia, serif;
		font-weight: 500;
