---
import "../styles/global.css";
import Navbar from "../Components/navbar.astro";
import Footer from "../Components/footer.astro";

const fruits = [
	{
		name: "Mango",
		img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQuu2lK_pa7Mf2W5mAkl2V_VDTmnZ43brmDuQ&s",
		des: "Cultivado con técnicas sostenibles, nuestro mango ofrece un sabor dulce y jugoso, ideal para consumo fresco o en preparaciones culinarias.",
	},
	{
		name: "Fresa",
		img: "https://www.agrorganicos.mx/cdn/shop/products/fresa_1080x.jpg?v=1569251998",
		des: "Nuestras fresas son cultivadas con procesos naturales, garantizando un sabor dulce y una textura jugosa, perfectas para consumo fresco o en postres.",
	},
	{
		name: "Frambuesa",
		img: "https://maiaorganicos.mx/wp-content/uploads/2021/04/frambuesas-natural.jpg",
		des: "Cultivada con técnicas sostenibles, nuestra frambuesa ofrece un sabor intenso y una textura jugosa, ideal para consumo fresco o en preparaciones culinarias.",
	},
	{
		name: "Piña",
		img: "https://www.herbazest.com/imgs/c/a/d/651803/pina.jpg",
		des: "Cultivada con técnicas sostenibles, nuestra piña ofrece un sabor dulce y una textura jugosa, ideal para consumo fresco o en preparaciones culinarias.",
	},
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Sano y Nutritivo Zamora | Frutas y Productos del Campo</title>
		<link rel="icon" href="/snz2.ico" />
		<meta
			name="google-site-verification"
			content="WFmqMszxb4OnPNz0WyLyd5nfs2ZN68Q9yiOe0BMQ6SY"
		/>
	</head>

	<body class="bg-gray-50 text-gray-800">
		<!-- NAVBAR -->
		<Navbar />

		<section
			class="relative h-[100vh] flex items-center justify-center text-center text-white overflow-hidden"
		>
			<div class="absolute inset-0">
				<img
					src="https://www.baltana.com/files/wallpapers-5/Raspberry-HD-Desktop-Wallpaper-16909.jpg"
					class="hero-img hero-slide active absolute inset-0 w-full h-full object-cover"
				/>
				<img
					src="https://images.unsplash.com/photo-1464226184884-fa280b87c399"
					class="hero-img hero-slide absolute inset-0 w-full h-full object-cover"
				/>
				<img
					src="https://images.unsplash.com/photo-1502741338009-cac2772e18bc"
					class="hero-img hero-slide absolute inset-0 w-full h-full object-cover"
				/>
			</div>

			<div
				class="absolute inset-0 bg-gradient-to-b from-black/70 via-transparent to-[#fdfdfd]"
			>
			</div>

			<div class="relative z-10 max-w-4xl px-6">
				<div
					class="inline-block px-4 py-1.5 mb-6 text-xs font-bold tracking-[0.4em] uppercase bg-white/10 backdrop-blur-md border border-white/20 rounded-full"
				>
					Excelencia en el Campo
				</div>
				<h1
					class="text-5xl md:text-8xl font-black mb-6 leading-tight drop-shadow-2xl"
				>
					SANO Y NUTRITIVO <span class="text-green-400">ZAMORA</span>
				</h1>
				<p
					class="text-xl md:text-2xl opacity-90 max-w-2xl mx-auto font-light italic"
				>
					"Calidad del campo directamente a tu negocio con procesos
					sostenibles."
				</p>
			</div>
		</section>

		<section class="relative -mt-16 z-20 pb-20">
			<div class="max-w-6xl mx-auto px-6">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					{
						["Certificación Kosher", "Certificación PrimusGFS"].map(
							(cert) => (
								<div class="flex items-center gap-6 rounded-[2.5rem] px-8 py-6 bg-white/70 backdrop-blur-2xl border border-white shadow-[0_20px_50px_rgba(0,0,0,0.05)] hover:-translate-y-2 transition-all duration-500 group">
									<div class="w-14 h-14 flex items-center justify-center rounded-2xl bg-gradient-to-br from-green-500 to-green-700 shadow-lg group-hover:rotate-12 transition-transform">
										<svg
											xmlns="http://www.w3.org/2000/svg"
											class="w-7 h-7 text-white"
											fill="none"
											viewBox="0 0 24 24"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="3"
												d="M5 13l4 4L19 7"
											/>
										</svg>
									</div>
									<h3
										class="font-bold text-xl text-gray-900"
										data-key={cert}
									>
										{cert}
									</h3>
								</div>
							),
						)
					}
				</div>
			</div>
		</section>

		<!-- FRUTAS / PRODUCTOS - ESTILO EDITORIAL -->
		<section class="py-32 px-6 bg-white">
			<div class="max-w-7xl mx-auto">
				<div
					class="flex flex-col md:flex-row justify-between items-end mb-20 gap-6"
				>
					<div class="max-w-2xl">
						<span
							class="text-green-600 font-bold tracking-widest uppercase text-xs"
							>Selección Premium</span
						>
						<h2
							class="text-5xl md:text-6xl font-light text-gray-900 mt-4 italic"
						>
							Nuestras <span
								class="font-black not-italic text-green-800"
								>Frutas</span
							>
						</h2>
					</div>
					<p
						class="text-gray-400 max-w-xs text-sm uppercase tracking-tighter leading-tight"
					>
						Cultivadas bajo estándares internacionales de inocuidad
						y frescura absoluta.
					</p>
				</div>

				<div class="grid gap-16 md:grid-cols-2 lg:grid-cols-4">
					{
						fruits.map((fruit) => (
							<div class="group cursor-pointer">
								<div class="relative overflow-hidden rounded-sm mb-6 aspect-[3/4]">
									<img
										src={fruit.img}
										alt={fruit.name}
										class="h-full w-full object-cover grayscale-[30%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000 ease-out"
									/>
									<div class="absolute inset-0 border-[15px] border-white/0 group-hover:border-white/20 transition-all duration-700" />
								</div>
								<h3 class="text-xs font-bold tracking-[0.3em] uppercase text-gray-900 mb-2">
									{fruit.name}
								</h3>
								<div class="h-px w-8 bg-green-500 mb-4 group-hover:w-16 transition-all duration-500" />
								<p class="text-gray-500 text-sm leading-relaxed font-light">
									{fruit.des}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- SOBRE NOSOTROS - ESTILO MAGAZINE -->
		<!-- SECCIÓN HISTORIA TIPO LAYERING -->
		<section class="py-40 px-6 bg-white">
			<div class="max-w-7xl mx-auto">
				<div class="relative grid lg:grid-cols-12 items-center">
					<!-- Imagen con marco asimétrico -->
					<div class="lg:col-span-8 relative">
						<div
							class="absolute inset-0 bg-green-900/5 -translate-x-6 translate-y-6"
						>
						</div>
						<img
							src="sano.jpg"
							class="relative w-full h-[700px] object-cover shadow-2xl"
							alt="Campo"
						/>
						<!-- Badge flotante -->
						<div
							class="absolute top-10 left-10 bg-green-800 text-white p-6 rotate-90 origin-left tracking-[0.5em] text-[10px] uppercase font-bold"
						>
							Est. 2017 — Zamora, Mich.
						</div>
					</div>

					<!-- Texto superpuesto -->
					<div
						class="lg:col-span-5 lg:absolute lg:right-0 bg-white p-12 lg:p-20 shadow-[50px_50px_100px_rgba(0,0,0,0.1)] mt-[-100px] lg:mt-0 z-20"
					>
						<h2
							class="text-6xl font-black text-gray-900 leading-[0.9] mb-8"
						>
							RAÍCES <br />
							<span
								class="text-green-700 italic font-serif font-light text-5xl"
								>que alimentan</span
							>
							<br /> EL MUNDO.
						</h2>
						<div class="w-20 h-1 bg-green-500 mb-8"></div>
						<p
							class="text-gray-600 text-xl font-light leading-relaxed italic"
						>
							"Empresa familiar líder en exportación, comprometida
							con la calidad suprema,
						</p>
						<p
							class="text-gray-600 text-xl font-light leading-relaxed italic"
						>
							 la salud y el respeto
							absoluto al medio ambiente."
						</p>
						<div class="mt-12 flex gap-10">
							<div>
								<span
									class="block text-4xl font-black text-gray-900"
									>9+</span
								>
								<span
									class="text-[10px] uppercase tracking-widest font-bold text-green-600"
									>Años de Legado</span
								>
							</div>
							<div>
								<span
									class="block text-4xl font-black text-gray-900"
									>3</span
								>
								<span
									class="text-[10px] uppercase tracking-widest font-bold text-green-600"
									>Continentes</span
								>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- FILOSOFÍA - CLEAN GLASS -->
		<section class="py-32 px-6 bg-white overflow-hidden">
			<div class="max-w-7xl mx-auto relative">
				<div
					class="grid gap-px bg-gray-100 border border-gray-100 md:grid-cols-3"
				>
					<div
						class="bg-white p-16 hover:bg-green-50 transition-colors duration-700"
					>
						<span
							class="text-4xl block mb-8 grayscale hover:grayscale-0 transition"
							>🎯</span
						>
						<h3
							class="text-xs font-bold tracking-[0.4em] uppercase text-green-800 mb-6"
						>
							Misión
						</h3>
						<p
							class="text-gray-500 text-sm leading-7 font-light uppercase"
						>
							Asegurar altos estándares de calidad e inocuidad en
							cada fruto procesado.
						</p>
					</div>

					<div
						class="bg-white p-16 hover:bg-green-50 transition-colors duration-700"
					>
						<span
							class="text-4xl block mb-8 grayscale hover:grayscale-0 transition"
							>🌎</span
						>
						<h3
							class="text-xs font-bold tracking-[0.4em] uppercase text-green-800 mb-6"
						>
							Visión
						</h3>
						<p
							class="text-gray-500 text-sm leading-7 font-light uppercase"
						>
							Ser referentes internacionales en el manejo de
							productos agroalimentarios.
						</p>
					</div>

					<div
						class="bg-white p-16 hover:bg-green-50 transition-colors duration-700"
					>
						<span
							class="text-4xl block mb-8 grayscale hover:grayscale-0 transition"
							>🤝</span
						>
						<h3
							class="text-xs font-bold tracking-[0.4em] uppercase text-green-800 mb-6"
						>
							Valores
						</h3>
						<ul
							class="text-[11px] font-bold uppercase tracking-[0.2em] space-y-4 text-gray-400"
						>
							<li class="flex items-center gap-4">
								<span class="w-2 h-2 bg-green-500 rounded-full"
								></span> Competitividad
							</li>
							<li class="flex items-center gap-4">
								<span class="w-2 h-2 bg-green-500 rounded-full"
								></span> Responsabilidad
							</li>
							<li class="flex items-center gap-4">
								<span class="w-2 h-2 bg-green-500 rounded-full"
								></span> Pasión
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA FINAL - MINIMALISMO ABSOLUTO -->
		<section
			class="py-40 px-6 bg-green-900 text-white relative overflow-hidden"
		>
			<div class="absolute inset-0 opacity-20">
				<img
					src="https://images.unsplash.com/photo-1502741338009-cac2772e18bc"
					class="w-full h-full object-cover"
				/>
			</div>
			<div class="max-w-4xl mx-auto text-center relative z-10">
				<h2
					class="text-5xl md:text-7xl font-light mb-12 leading-tight italic"
				>
					Lleve la frescura de <br />
					<span class="font-black not-italic"
						>Zamora a su Negocio.</span
					>
				</h2>
				<a
					href="/contactanos"
					class="group relative inline-flex items-center gap-8 px-12 py-6 border border-white/30 hover:border-white transition-all duration-500 overflow-hidden"
				>
					<span
						class="relative z-10 font-bold tracking-[0.3em] uppercase text-sm"
						>Iniciar Alianza</span
					>
					<span
						class="relative z-10 transition-transform group-hover:translate-x-2"
						>→</span
					>
					<div
						class="absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-500"
					>
					</div>
					<span
						class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 text-green-900 font-bold tracking-[0.3em] uppercase text-sm transition-opacity duration-500 z-20"
					>
						Iniciar Alianza
					</span>
				</a>
			</div>
		</section>

		<!-- FOOTER -->
		<Footer />
	</body>
</html>
<style>
	/* zoom suave */
	.hero-img {
		animation: heroZoom 30s ease-in-out infinite alternate;
	}

	/* fade slider */
	.hero-slide {
		opacity: 0;
		transition: opacity 2s ease;
	}

	.hero-slide.active {
		opacity: 1;
	}

	/* zoom animation */
	@keyframes heroZoom {
		0% {
			transform: scale(1);
		}
		100% {
			transform: scale(1.15);
		}
	}
</style>

<script>
	const slides = document.querySelectorAll(".hero-slide");
	let index = 0;

	setInterval(() => {
		slides[index].classList.remove("active");

		index = (index + 1) % slides.length;

		slides[index].classList.add("active");
	}, 7000);
</script>
